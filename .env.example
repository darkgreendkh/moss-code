# Copy this file to .env and fill only the providers you use.

# Optional provider selector. CLI --provider still takes precedence.
MOSS_PROVIDER=deepseek

# Recommended default. DeepSeek uses its Anthropic-compatible endpoint.
MOSS_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
MOSS_DEEPSEEK_API_KEY=
MOSS_DEEPSEEK_MODEL=deepseek-v4-pro

# Official OpenAI endpoint. Change this if you use another /responses-compatible service.
MOSS_OPENAI_API_BASE=https://api.openai.com/v1
MOSS_OPENAI_API_KEY=
MOSS_OPENAI_MODEL=gpt-5-5

# Official Anthropic endpoint. Change this if you use another /messages-compatible service.
MOSS_ANTHROPIC_API_BASE=https://api.anthropic.com/v1
MOSS_ANTHROPIC_API_KEY=
MOSS_ANTHROPIC_MODEL=claude-opus-5

# Optional comma-separated extra env names to redact from traces and reports.
MOSS_SECRET_ENV_NAMES=

# Repo context (spec-01). All optional; defaults shown.
# Repo map: a cheap directory skeleton + symbol index injected into the workspace
# section. Set to "off" to fall back to the pre-repo-map prefix exactly.
MOSS_REPO_MAP=on
MOSS_REPO_MAP_BUDGET=800
# Workspace snapshot strategy: git (changed set only) / walk (full scan) / auto.
MOSS_SNAPSHOT_STRATEGY=auto
# Extra comma-separated globs to exclude from snapshots and the repo map.
MOSS_SNAPSHOT_EXCLUDE=

# Context budget (spec-06). The total prompt budget is derived from the model's
# context window: min(window * ratio, hard cap) - output reserve. Models we do not
# recognize keep the historical 12000-token budget instead of trusting a guess.
MOSS_CONTEXT_RATIO=0.5
MOSS_CONTEXT_HARD_CAP=60000

# Run retention (spec-07). Runs older than both thresholds are packed into
# .moss/runs/<run_id>.jsonl.gz and removed. Pinned runs, runs holding a live
# lease, and runs referenced by artifacts/*.json are never cleaned up.
# Set either to 0 to disable that dimension.
MOSS_RUN_RETENTION_COUNT=200
MOSS_RUN_RETENTION_DAYS=30

# Prompt behavior is controlled by CLI flags: --no-prompt-cache,
# --tool-protocol auto|native|text, and --context-mode rerender|append_only.
# A local .moss/prompts/system.md overrides the built-in p1 system prompt.

# ---- spec-09 扩展点 ----------------------------------------------------
# 全部由 CLI 开关控制，默认关闭或行为不变：
#   --record DIR / --replay DIR / --replay-on-miss fail|nearest|passthrough
#   --aux-model / --aux-provider   脏活走便宜模型；不设即全部回落主模型
#   --enable-code-mode             需要沙箱可用，否则即使开了也不暴露工具
#
# MCP server 与工具目录阈值写在 .moss/config.json（不是 .env，因为是结构化配置）：
#   {"mcp": {"catalog_threshold": 16,
#            "servers": {"fs": {"command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
#                               "capabilities": ["fs_read"],
#                               "tools": ["read_file"]}}}}
# capabilities 是必填的：外部工具 fail-closed，缺声明直接拒绝注册。
#
# 用户钩子放在 .moss/hooks/{pre_tool,post_tool,pre_final,post_run}（需要可执行位）。
